{
  "name": "unicode-map",
  "version": "1.0.0",
  "private": true,
  "description": "A bunch of Unicode characters in a poster, on a Hilbert curve",
  "keywords": [],
  "homepage": "https://github.com/eggplants/unicode-map#readme",
  "bugs": {
    "url": "https://github.com/eggplants/unicode-map/issues"
  },
  "license": "MIT",
  "author": "Koki Takahashi <hakatasiloving@gmail.com> (http://hakatashi.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggplants/unicode-map.git"
  },
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=4096 src/index.ts",
    "watch": "node --max-old-space-size=4096 --watch-path=src --watch-path=data --watch-preserve-output src/index.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "hilbert": "^2.0.0",
    "jsdom": "^30.0.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "progress": "^2.0.3",
    "tar": "^7.5.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/progress": "^2.0.7",
    "vite-plus": "0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
    }
  }
}
